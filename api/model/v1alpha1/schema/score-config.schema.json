{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llmobs.com/schemas/model/v1alpha1/score-config.schema.json",
  "title": "LLMObs canonical ScoreConfig (v1alpha1)",
  "type": "object",
  "additionalProperties": false,
  "$comment": "04-score.md §3. The definition constraining scores of a given name/type. data_type is aligned to the three measurement types.",
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "project_id": { "$ref": "common.schema.json#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "data_type": { "enum": ["numeric", "categorical", "boolean"] },
    "is_archived": { "type": "boolean", "default": false },
    "min_value": { "type": ["number", "null"] },
    "max_value": { "type": ["number", "null"] },
    "categories": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "value": { "type": "number" }
            },
            "required": ["label", "value"]
          },
          "minItems": 1
        },
        { "type": "null" }
      ]
    },
    "description": { "type": ["string", "null"] }
  },
  "required": ["id", "project_id", "name", "data_type", "is_archived"],
  "allOf": [
    {
      "$comment": "numeric: categories MUST be null; min/max optional (max > min enforced in spec, not schema).",
      "if": { "properties": { "data_type": { "const": "numeric" } }, "required": ["data_type"] },
      "then": { "properties": { "categories": { "type": "null" } } }
    },
    {
      "$comment": "categorical/boolean: categories required (non-null array).",
      "if": { "properties": { "data_type": { "enum": ["categorical", "boolean"] } }, "required": ["data_type"] },
      "then": {
        "properties": {
          "categories": {
            "type": "array",
            "minItems": 1
          }
        },
        "required": ["categories"]
      }
    }
  ]
}
