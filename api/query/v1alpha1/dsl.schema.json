{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llmobs.com/schemas/query/v1alpha1/dsl.schema.json",
  "title": "LLMObs Query DSL document (v1alpha1)",
  "$comment": "Encodes QD-1..QD-7 structurally: query shape, per-class operator enums, nesting-depth cap (an OR group cannot contain another OR group), and the contract ceilings (00-dsl-spec.md §12) as maximum/maxItems. Field-class<->operator matching and the total-conditions count are enforced by the kernel against fields.json; this schema enforces the structural envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "target", "timeRange"],
  "properties": {
    "version": { "const": "v1alpha1" },
    "target": { "enum": ["spans", "traces", "scores"] },
    "timeRange": { "$ref": "#/$defs/timeRange" },
    "filters": {
      "type": "array",
      "items": { "$ref": "#/$defs/filterMember" },
      "maxItems": 32
    },
    "scores": {
      "type": "array",
      "items": { "$ref": "#/$defs/scoreCondition" },
      "maxItems": 32
    },
    "groupBy": {
      "type": "array",
      "items": { "$ref": "#/$defs/groupByMember" },
      "maxItems": 3
    },
    "aggregations": {
      "type": "array",
      "items": { "$ref": "#/$defs/aggregation" },
      "maxItems": 10
    },
    "orderBy": {
      "type": "array",
      "items": { "$ref": "#/$defs/orderByMember" }
    },
    "limit": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "cursor": { "type": "string" }
  },
  "allOf": [
    {
      "$comment": "QD-9: `scores` is valid only on target=traces.",
      "if": { "properties": { "target": { "enum": ["spans", "scores"] } }, "required": ["target"] },
      "then": { "not": { "required": ["scores"] } }
    },
    {
      "$comment": "QD-1: a cursor (row-query paging) may not accompany aggregations.",
      "if": { "required": ["aggregations"] },
      "then": { "not": { "required": ["cursor"] } }
    }
  ],
  "$defs": {
    "rfc3339": { "type": "string", "format": "date-time" },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "#/$defs/rfc3339" },
        "to": { "$ref": "#/$defs/rfc3339" }
      },
      "required": ["from", "to"]
    },
    "simpleOp": {
      "enum": ["eq", "neq", "in", "not_in", "contains", "starts_with", "is_null",
               "gt", "gte", "lt", "lte", "contains_any", "contains_all"]
    },
    "simpleCondition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "op": { "$ref": "#/$defs/simpleOp" },
        "value": true
      },
      "required": ["field", "op"],
      "allOf": [
        {
          "$comment": "QD-7: in/not_in/contains_any/contains_all values are arrays capped at MAX_IN_LIST (256).",
          "if": { "properties": { "op": { "enum": ["in", "not_in", "contains_any", "contains_all"] } }, "required": ["op"] },
          "then": { "properties": { "value": { "type": "array", "maxItems": 256 } }, "required": ["value"] }
        },
        {
          "$comment": "Non-null, non-array-op conditions require a value.",
          "if": { "properties": { "op": { "enum": ["eq", "neq", "contains", "starts_with", "gt", "gte", "lt", "lte"] } }, "required": ["op"] },
          "then": { "required": ["value"] }
        }
      ]
    },
    "mapCondition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": { "enum": ["attributes", "usage_details", "cost_details", "provided_usage_details", "provided_cost_details"] },
        "key": { "type": "string", "minLength": 1 },
        "op": { "enum": ["eq", "neq", "contains", "exists", "gt", "gte", "lt", "lte"] },
        "value": true
      },
      "required": ["field", "key", "op"],
      "allOf": [
        {
          "$comment": "`exists` needs no value; all other map ops require one.",
          "if": { "properties": { "op": { "not": { "const": "exists" } } }, "required": ["op"] },
          "then": { "required": ["value"] }
        }
      ]
    },
    "referenceCondition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "op": { "const": "ref_eq" },
        "value": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ref_type": { "type": "string", "minLength": 1 },
            "ref_id": { "type": "string", "minLength": 1 },
            "ref_label": { "type": "string" }
          },
          "required": ["ref_type", "ref_id"]
        }
      },
      "required": ["field", "op", "value"]
    },
    "orGroup": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "QD-3: nesting depth cap — an OR group contains only leaf conditions, never another `any` group.",
      "properties": {
        "any": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/simpleCondition" },
              { "$ref": "#/$defs/mapCondition" },
              { "$ref": "#/$defs/referenceCondition" }
            ]
          }
        }
      },
      "required": ["any"]
    },
    "filterMember": {
      "oneOf": [
        { "$ref": "#/$defs/simpleCondition" },
        { "$ref": "#/$defs/mapCondition" },
        { "$ref": "#/$defs/referenceCondition" },
        { "$ref": "#/$defs/orGroup" }
      ]
    },
    "aggregation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": { "enum": ["count", "count_distinct", "sum", "avg", "min", "max", "p50", "p90", "p95", "p99"] },
        "field": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "alias": { "type": "string", "minLength": 1 }
      },
      "required": ["op"]
    },
    "groupByMember": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "field": { "enum": ["start_time", "timestamp"] },
            "interval": { "enum": ["1m", "5m", "1h", "1d"] }
          },
          "required": ["field", "interval"]
        }
      ]
    },
    "orderByMember": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "dir": { "enum": ["asc", "desc"] }
      },
      "required": ["field", "dir"]
    },
    "scoreCondition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "data_type": { "enum": ["numeric", "categorical", "boolean"] },
        "op": { "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "in", "not_in"] },
        "value": true,
        "source": { "enum": ["human", "llm_judge", "code", "external"] }
      },
      "required": ["name", "op", "value"]
    }
  }
}
