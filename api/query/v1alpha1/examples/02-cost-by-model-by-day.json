{ "version":"v1alpha1", "target":"spans", "timeRange":{"from":"2026-07-01T00:00:00Z","to":"2026-07-08T00:00:00Z"},
  "filters":[ {"field":"kind","op":"eq","value":"generation"} ],
  "groupBy":[ "model", {"field":"start_time","interval":"1d"} ],
  "aggregations":[ {"op":"sum","field":"total_cost","alias":"cost"},
                   {"op":"count","alias":"calls"},
                   {"op":"sum","field":"usage_details","key":"total","alias":"tokens"} ] }
