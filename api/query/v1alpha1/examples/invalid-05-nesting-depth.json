{
  "version": "v1alpha1",
  "target": "spans",
  "timeRange": {
    "from": "2026-07-01T00:00:00Z",
    "to": "2026-07-08T00:00:00Z"
  },
  "filters": [
    {
      "any": [
        {
          "field": "environment",
          "op": "eq",
          "value": "prod"
        },
        {
          "any": [
            {
              "field": "kind",
              "op": "eq",
              "value": "generation"
            }
          ]
        }
      ]
    }
  ]
}