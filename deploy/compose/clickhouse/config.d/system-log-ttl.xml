<?xml version="1.0"?>
<!--
  R-CH6 (Langfuse scale scar): ClickHouse's own system.*_log tables grow without
  bound by default and have sunk self-hosters' disks. This drop-in:
    - DISABLES the sampling profiler logs (trace_log, query_thread_log) — the
      heaviest, rarely needed in production observability of LLMObs itself.
    - TTLs the rest to 14 days so operational logs self-prune.
  Mounted read-only into /etc/clickhouse-server/config.d. Adjust the interval per
  your retention needs; the point is that NO system log is unbounded by default.
-->
<clickhouse>
    <!-- Profiler off. -->
    <trace_log remove="1"/>
    <query_thread_log remove="1"/>

    <!-- TTL the operational logs. -->
    <query_log>
        <ttl>event_date + INTERVAL 14 DAY DELETE</ttl>
    </query_log>
    <part_log>
        <ttl>event_date + INTERVAL 14 DAY DELETE</ttl>
    </part_log>
    <metric_log>
        <ttl>event_date + INTERVAL 14 DAY DELETE</ttl>
    </metric_log>
    <asynchronous_metric_log>
        <ttl>event_date + INTERVAL 14 DAY DELETE</ttl>
    </asynchronous_metric_log>
    <error_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </error_log>
</clickhouse>
