# ────────────────────────────────────────────────────────────────────────────
# DEV / CI-ONLY credentials for the compose profiles (dev, lite, scale).
#
# These are intentionally weak, well-known values, safe ONLY because the compose
# stacks are local/CI throwaways with no host-published database ports (except the
# dev-profile Postgres, bound to localhost). They are NOT secret and NOT for any
# real deployment.
#
# The compose files reference every credential as ${VAR:?...} (REQUIRED, no inline
# default) precisely so that copying a compose file to a real host and running it
# without supplying these values FAILS LOUDLY at parse time instead of silently
# booting with a password an attacker already knows. A production deployment supplies
# these from a real secret store (or its own --env-file), never from this file.
#
# `make dev`, `make e2e`, and the e2e-compose CI job load this file explicitly via
# `docker compose --env-file deploy/compose/dev.env`.
# ────────────────────────────────────────────────────────────────────────────

# Datastore passwords (username stays the brand default; only the password is a secret).
LLMOBS_POSTGRES_PASSWORD=llmobs-dev
LLMOBS_CLICKHOUSE_PASSWORD=llmobs-dev

# Object store (MinIO) credentials for the scale-profile blobs backend. Dev-only.
LLMOBS_BLOB_S3_ACCESS_KEY=llmobs-blob-dev
LLMOBS_BLOB_S3_SECRET_KEY=llmobs-blob-dev-secret

# First-boot bootstrap identity. The API key matches the value the e2e scripts emit.
LLMOBS_BOOTSTRAP_API_KEY=sk-e2e-demo-key
LLMOBS_BOOTSTRAP_ADMIN_PASSWORD=admin-dev-password
