{
  "name": "@llmobs/plugin-sdk",
  "version": "0.1.0",
  "description": "The LLMObs plugin SDK (Tier-2 surface). A plugin frontend imports ONLY this (plus @llmobs/ui, @llmobs/tokens): the provider, data hooks over the Query API, the manifest types, and the standard degraded-state components. Semver-sacred.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^18.3.0"
  },
  "dependencies": {
    "@llmobs/query-client": "workspace:*",
    "@llmobs/tokens": "workspace:*",
    "@llmobs/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "react": "18.3.1",
    "typescript": "5.6.3"
  }
}
